spring.application.name=buslink-backend
server.port=8080

# ─── H2 In-Memory Database (default dev mode – no installation required) ───────
# Comment out this block and uncomment the MySQL block below for production.
spring.datasource.url=jdbc:h2:mem:buslink_db;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# ─── MySQL Configuration (uncomment and fill in for production) ─────────────────
# spring.datasource.url=jdbc:mysql://localhost:3306/buslink_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# spring.datasource.username=YOUR_MYSQL_USERNAME
# spring.datasource.password=YOUR_MYSQL_PASSWORD
# spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver

# ─── JPA / Hibernate ────────────────────────────────────────────────────────────
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# ─── JWT Configuration ──────────────────────────────────────────────────────────
# IMPORTANT: Set the APP_JWT_SECRET environment variable to a secure 256-bit key.
# Never commit a real secret here. Generate one with: openssl rand -hex 32
app.jwt.secret=${APP_JWT_SECRET:dev-only-change-me-in-production-use-env-var}
app.jwt.expiration-ms=86400000

# ─── Logging ────────────────────────────────────────────────────────────────────
logging.level.com.buslink=INFO
logging.level.org.springframework.security=INFO

# ─── Dev Seed Admin Credentials ─────────────────────────────────────────────────
# Override via environment variables for production deployments.
app.admin.email=${BUSLINK_ADMIN_EMAIL:admin@buslink.com}
app.admin.password=${BUSLINK_ADMIN_PASSWORD:Admin@123}
