# BUS-LINK Production & Docker Environment Variables
# Rename this file to .env before starting production deployments

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/buslink_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=buslink_user
DATABASE_PASSWORD=your_secure_mysql_password_here

# Spring Security & JWT Configuration
JWT_SECRET=your_256_bit_cryptographic_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Mail Server Configuration (Optional Dev/Prod Mode)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Frontend Configuration
PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
